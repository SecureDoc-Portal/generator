# Read by `next build`. Unlike .env.example (which Next never reads), values
# here actually reach the bundle.
#
# Both are browser-visible by design and safe in a public repo: the publishable
# key grants only what Row Level Security allows, and every table in the
# project has RLS enabled. The service-role key is NOT here — it belongs only
# in Supabase Edge Function secrets.
#
# The deploy workflow's `vars.*` values override these when set, so a fork can
# point at a different project without editing the file.
NEXT_PUBLIC_SUPABASE_URL=https://oadssynldelrkinhreza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Y1jiS-zw5beFYQj1vWQixw_IHJUGjRN
