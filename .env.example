# repository variables, which override it.
#
# ---------------------------------------------------------------------------
# Browser-visible. Safe to commit to your deployment settings and safe to ship
# in the built bundle: the anon key only grants what Row Level Security allows.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://oadssynldelrkinhreza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Y1jiS-zw5beFYQj1vWQixw_IHJUGjRN

# Set by the deploy workflow for GitHub Pages project sites (e.g. /secdocgenerator).
# Leave empty for local development or a custom domain at the apex.
NEXT_PUBLIC_BASE_PATH=/secdocgenerator

